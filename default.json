{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Geteilte Renovate-Konfiguration der Organisation it-erben.",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "github-actions",
    "maven",
    "gradle",
    "npm",
    "nuget",
    "pip_requirements",
    "dockerfile",
    "docker-compose",
    "helm-values",
    "helmv3",
    "terraform",
    "pre-commit"
  ],
  "pre-commit": {
    "enabled": true
  },
  "dependencyDashboard": false,
  "packageRules": [
    {
      "description": "Minor- und Patch-Anhebungen außerhalb der Workflows kommen je Repository in einem Pull Request.",
      "matchManagers": [
        "maven",
        "gradle",
        "npm",
        "nuget",
        "pip_requirements",
        "dockerfile",
        "docker-compose",
        "helm-values",
        "helmv3",
        "terraform",
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "minor- und patch-updates"
    },
    {
      "description": "Aktualisierungen der eigenen Workflows laufen ohne Zutun durch.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "it-erben/ci"
      ],
      "automerge": true,
      "platformAutomerge": true
    }
  ]
}

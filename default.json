{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Geteilte Renovate-Konfiguration der Organisation it-erben.",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "github-actions"
  ],
  "dependencyDashboard": false,
  "packageRules": [
    {
      "description": "Aktualisierungen der eigenen Workflows laufen ohne Zutun durch.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "it-erben/ci"
      ],
      "automerge": true,
      "platformAutomerge": true
    }
  ]
}
